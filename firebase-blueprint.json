{
  "collections": {
    "users": {
      "description": "User profiles and aggregate stats",
      "documents": {
        "{userId}": {
          "fields": {
            "username": "string",
            "telegramUsername": "string?",
            "firstName": "string?",
            "telegramId": "number?",
            "points": "number",
            "rank": "number",
            "inviteCount": "number",
            "invitedUsers": "array?",
            "referredBy": "string?",
            "createdAt": "timestamp",
            "lastActiveAt": "timestamp?",
            "lastActiveTimestamp": "number?",
            "lastCheckIn": "timestamp?",
            "betaBalances": "map",
            "realBalances": "map",
            "openedChests": "string[]",
            "taskProgress": "map"
          }
        }
      }
    },
    "userTasks": {
      "description": "User specific task completion status",
      "documents": {
        "{userId}_{taskId}": {
          "fields": {
            "userId": "string",
            "taskId": "string",
            "isCompleted": "boolean",
            "completedAt": "timestamp"
          }
        }
      }
    },
    "referrals": {
      "description": "Referral tracking",
      "documents": {
        "{referralId}": {
          "fields": {
            "referrerId": "string",
            "referredId": "string",
            "createdAt": "timestamp"
          }
        }
      }
    },
    "transactions": {
      "description": "Transaction logs for all token rewards and distributions",
      "documents": {
        "{txId}": {
          "fields": {
            "id": "string",
            "userId": "string",
            "telegramId": "string?",
            "username": "string",
            "source": "string",
            "rewardSource": "string",
            "amount": "number",
            "timestamp": "number",
            "createdAt": "timestamp"
          }
        }
      }
    },
    "global": {
      "description": "Global app parameters and distributed asset metrics",
      "documents": {
        "assets": {
          "fields": {
            "totalDistributedTokens": "number",
            "totalRewardCount": "number",
            "lastUpdatedAt": "timestamp"
          }
        }
      }
    }
  }
}
