rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        // Allow crediting referral rewards to referrer
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'betaBalances', 'realBalances', 'referralEarnings', 'inviteCount', 'invitedUsers'
        ])
      );
    }
    match /userTasks/{taskDocId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid
      );
    }
    match /referrals/{refId} {
      allow read: if request.auth != null;
      allow write, create, update: if request.auth != null;
    }
  }
}

